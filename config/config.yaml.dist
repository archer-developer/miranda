# Miranda agent configuration.
#
# Every field here has a built-in default (see internal/config/config.go),
# so you only need to override what differs from the default. Copy this file
# to config.yaml and edit it; config.yaml is gitignored since it typically
# contains real entity ids and other environment-specific details (secrets
# themselves stay out of this file entirely — see the *_env fields below,
# which name environment variables to read at startup).

server:
  # Address the unified command interface + web UI listen on.
  http_addr: ":8787"
  # Bearer token required on POST /api/v1/input and the web UI's API calls.
  # Leave empty for LAN-only dev use with no auth.
  auth_token: ""
  tls:
    # Adds a second, HTTPS listener on tls.addr — http_addr above keeps
    # serving plain HTTP either way, this never replaces it. Off by default:
    # most deployments that need a *trusted* cert (WebAuthn's rp_origins, a
    # Telegram webhook, a browser with no manual trust step) already front
    # Miranda with a reverse proxy that terminates one. Turn this on for
    # direct HTTPS to Miranda itself — e.g. reaching it by LAN IP with no
    # proxy in front — where a one-time browser warning (or `curl -k`) is an
    # acceptable trade.
    enabled: false
    addr: ":8443"
    # If neither file exists at startup, Miranda generates a self-signed
    # cert/key pair here itself (see internal/tlscert) — nothing else to
    # configure for the common case. Point these at a real cert/key pair
    # instead to skip self-signed generation; an existing pair is never
    # overwritten.
    cert_file: "./data/tls/cert.pem"
    key_file: "./data/tls/key.pem"
    # DNS names/IPs (SANs) the generated self-signed cert is valid for.
    # Ignored once cert_file/key_file exist. "localhost"/"127.0.0.1" are
    # always included even if omitted here.
    hosts: []

storage:
  sqlite_path: "./data/miranda.db"
  memory_dir: "./data/memory"
  # Where gemini_tts's content-addressed, permanent (no TTL) rendered-audio
  # cache lives, and what GET /tts-audio/{key}.{ext} serves out of. Only
  # relevant if tts.gemini_tts is enabled.
  tts_cache_dir: "./data/storage"
  # Separate small SQLite file for passkey credentials (see webauthn:
  # below) — kept apart so wiping/backing up dialog history never touches
  # registered passkeys, and vice versa. Only used if webauthn.enabled.
  webauthn_sqlite_path: "./data/webauthn.db"
  # Separate SQLite file for scheduled tasks (see schedule: below) — same
  # reasoning as webauthn_sqlite_path. Only used if schedule.enabled.
  schedule_sqlite_path: "./data/schedule.db"
  # Separate SQLite file holding every user's wrapped master-key slots (see
  # internal/keyring, docs/encryption.md — the keyring itself is always on,
  # no config toggle). Unlike the other optional SQLite files above, losing
  # this one is data-loss-equivalent to losing every piece of data
  # encrypted under it — back it up at least as carefully as sqlite_path,
  # not as an afterthought.
  keyring_sqlite_path: "./data/keyring.db"
  # Separate SQLite file holding encrypted OAuth2 access/refresh tokens
  # (internal/oauth2, docs/adr/oauth2-layer.md) — one row per (username,
  # provider). Only used when oauth.enabled below is true.
  oauth_sqlite_path: "./data/oauth.db"

logging:
  # Mirrors everything on stdout into logging.dir/miranda.log, plus a
  # separate logging.dir/llm.log tracing every LLM request (system prompt,
  # messages, tools) and response (text/tool calls) — useful for debugging
  # why a prompt didn't produce the expected behavior. Both rotate by size.
  dir: "./logs"
  # "debug", "info", "warn", or "error". "debug" adds tool-call timings, web
  # search queries, and other verbose diagnostic output.
  level: "info"
  max_size_mb: 10
  max_backups: 5
  max_age_days: 30

llm:
  # Tried in this order: first is normal/default, later ones are the
  # reliability fallback chain if an earlier provider errors or times out —
  # unless default_provider below names one to move to the front instead.
  providers:
    - name: local-qwen
      type: openai_compat # any OpenAI Chat Completions compatible backend
      base_url: "http://localhost:11434/v1" # e.g. Ollama, vLLM, LM Studio, OpenRouter
      model: "qwen2.5:14b"
      api_key_envs: [] # env var name(s) holding the API key, if the backend needs one
      # Lets the primary/local model hand a hard turn off to a stronger
      # model by calling this tool itself, instead of every turn paying for
      # the expensive model. Each provider configures its own escalation
      # target/tool name, so a chain (e.g. local -> gemini -> claude) can
      # have each hop pick a progressively stronger target — see
      # config/llm.yaml for a worked 3-tier example.
      escalation:
        enabled: true
        tool_name: "escalate_to_claude"
        target_provider: claude
    - name: claude
      type: anthropic
      model: "claude-sonnet-5"
      api_key_envs: ["ANTHROPIC_API_KEY"]
      # Claude's own server-executed tools (run by Anthropic itself, not
      # through Miranda's tool loop). These coexist safely with tavily: below
      # — Tavily's tools are named "tavily_web_search"/"tavily_web_fetch"
      # while these are "web_search"/"web_fetch", so no naming collision.
      # When both are enabled Claude sees all four and prefers its own
      # server-side native ones (faster, no external API key); Gemini and
      # other providers in the chain only see the Tavily ones.
      # code_execution lets sandboxed Python call Claude's OWN native
      # web_search/web_fetch as a helper within the same Anthropic round-trip.
      anthropic_tools:
        web_search: true
        web_fetch: true
        code_execution: true
      # No escalation block — top of this chain, nowhere further to hand
      # off to. The zero-value (disabled) EscalationConfig is correct here.
  # Honored regardless of the providers list's own order (router.New moves
  # this name to the front of the fallback chain) — empty means "use the
  # list order above as-is".
  default_provider: local-qwen
  # A native Gemini provider (type: gemini) is also available — see
  # config/llm.yaml for a worked example, including its own multi-key
  # rotation (api_key_envs takes several env var names; unlike anthropic/
  # openai_compat, which only ever use the first, Gemini actually rotates
  # across all of them on a quota or server error). Its own native
  # gemini_tools.google_search (Grounding with Google Search) is NOT
  # recommended: it has a zero quota on the free-tier Gemini Developer API,
  # not merely a low one, so every request that touches it fails with
  # RESOURCE_EXHAUSTED — use tavily: below instead. Gemini's code-execution
  # tool is Vertex AI-only and not offered here, unlike Claude's
  # anthropic_tools.code_execution above.

# Miranda's own tavily_web_search/tavily_web_fetch tools (internal/tools,
# backed by Tavily — https://tavily.com), offered identically to every LLM
# provider above via the Orchestrator's own tool loop. These names don't
# collide with Anthropic's native "web_search"/"web_fetch" (see Claude's
# anthropic_tools block above), so both can be enabled simultaneously.
# Both default to false (opt-in — needs a real Tavily API key, set as
# TAVILY_API_KEY — see .env.example).
tavily:
  api_key_env: "TAVILY_API_KEY"
  web_search:
    enabled: false
    max_results: 5 # bounds how many results are spent into the model's context per search
  web_fetch:
    enabled: false

memory:
  # End-of-session LLM summarization pass that merges durable facts into
  # data/memory/<user_id>.md, as a safety net alongside the explicit tool below.
  auto_summarize: true
  # Lets the model call remember_this mid-conversation to save a fact immediately.
  explicit_tool: true
  # How long a conversation can sit idle before it's ended and summarized.
  # The server owns session continuity (not any conversation_id a caller
  # sends back), so this is what actually governs session boundaries.
  session_idle_timeout_minutes: 25
  # Lets the model call search_history when the user references an earlier
  # conversation ("помнишь мы говорили о..."), and the companion
  # restore_conversation tool to resume one as the active session ("давай
  # вернёмся к диалогу...", "давай вернёмся к последнему диалогу").
  search_history_tool: true
  # Lets the model call end_conversation when the user asks to start a new
  # conversation, ending the session immediately instead of waiting for the
  # idle timeout.
  end_conversation_tool: true
  # Lets the model call forget_conversation when the user asks to erase the
  # current conversation entirely ("забудь этот диалог"), deleting it from
  # history with no summarization.
  forget_conversation_tool: true

schedule:
  # Lets the model create/list/delete its own scheduled tasks
  # (create_scheduled_task/list_scheduled_tasks/delete_scheduled_task) — a
  # one-off reminder ("сегодня в 22:00 напомни мне...") or a recurring
  # routine ("каждое утро в 9:01..."). When a task fires, its stored
  # free-text prompt is replayed through the agent loop as a live turn — the
  # model decides which of its own tools (speak_reply, send_telegram, etc.)
  # to call. No deployment-specific secret needed, so this defaults to true.
  enabled: true

# Periodic database + config backups (internal/backup) — off by default,
# same reasoning as webauthn/telegram/oauth: dir is deployment-specific
# (often an external disk mount), so there's no safe default to silently
# start writing to. When enabled, every tick:
#   - snapshots every storage.*_sqlite_path file that currently exists on
#     disk via SQLite's own VACUUM INTO (a transactionally consistent copy,
#     safe to take while Miranda is running and mid-write — unlike a raw
#     file copy);
#   - copies this config/ directory's *.yaml files, and the .env file
#     Miranda was started with (API keys, OAUTH_MASTER_KEY, ...) — included
#     deliberately despite being sensitive, since oauth.db/keyring.db are
#     encrypted under keys that live only in .env and are otherwise useless
#     without it;
# into dir/<UTC timestamp>/, with the oldest snapshots beyond
# retention_count pruned after each successful run.
backup:
  enabled: false
  # Absolute path onto a separately mounted disk is recommended — a backup
  # that lives on the same disk as the data it backs up doesn't protect
  # against losing that disk. Relative paths (under the working directory)
  # are also fine for local/dev use. Created automatically if missing.
  dir: "/mnt/backup/miranda"
  interval_minutes: 1440 # once a day
  retention_count: 7 # keep the 7 most recent daily backups; 0 = keep all

# Optional generic OAuth2 authorization layer (internal/oauth2,
# docs/adr/oauth2-layer.md) — off by default, same reasoning as webauthn/
# telegram above: there's no safe auto-detected public_base_url. Lets
# household members connect their own third-party account (Google Calendar
# first) via the oauth_authorize tool + a callback route. The google_calendar
# provider below is consumed by Miranda's own native calendar_* tools
# (internal/calendar, internal/httpapi/calendar_tools.go) — a plain Calendar
# API v3 REST client, NOT Google's hosted Calendar MCP server
# (calendarmcp.googleapis.com): that product turned out to be gated behind
# enrollment in the Google Workspace Developer Preview Program, while this
# REST API is generally available and works with the exact same token.
oauth:
  enabled: false
  public_base_url: "https://miranda.example.com"
  # Provider name is appended: "/oauth/callback" -> "/oauth/callback/google_calendar".
  # Must match the redirect URI registered with each provider exactly.
  callback_path: "/oauth/callback"
  # Env var holding the base64-encoded 32-byte AES-256 key refresh/access
  # tokens are encrypted at rest under (internal/oauth2.LoadMasterKey) —
  # never in this file. Generate one with `openssl rand -base64 32`.
  master_key_env: "OAUTH_MASTER_KEY"
  providers:
    - name: google_calendar
      description: "Google Calendar"
      authorize_url: "https://accounts.google.com/o/oauth2/v2/auth"
      token_url: "https://oauth2.googleapis.com/token"
      client_id_env: "GOOGLE_OAUTH_CLIENT_ID"
      client_secret_env: "GOOGLE_OAUTH_CLIENT_SECRET"
      # calendar.events (not the narrower .events.readonly) is what lets
      # calendar_create_event/update_event/delete_event write, not just
      # read — calendarlist.readonly/events.freebusy stay read-only since
      # nothing needs to create/delete whole calendars or change calendar
      # settings.
      scopes:
        - "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
        - "https://www.googleapis.com/auth/calendar.events.freebusy"
        - "https://www.googleapis.com/auth/calendar.events"
      pkce: true
      # access_type=offline + prompt=consent is what makes Google actually
      # issue a refresh_token: without it, re-consenting an already-connected
      # user silently omits one.
      extra_authorize_params:
        access_type: offline
        prompt: consent

mcp:
  servers:
    - name: ha
      url: "http://homeassistant.local:8123/api/mcp"
      token_env: "HA_MCP_TOKEN" # Home Assistant Long-Lived Access Token
      enabled: true
    - name: code_exec_sandbox
      url: "http://127.0.0.1:8788/mcp"
      token_env: "SANDBOX_MCP_TOKEN"
      enabled: true
      # Opts this server into the generic file-download proxy (see
      # file_upload's own comment below): executeTool scans every tool
      # result routed to this server for a URL rooted at its own
      # "/files" endpoint (derived from url above by replacing the "/mcp"
      # suffix) — covers the sandbox's download_file tool, no
      # server-specific wiring needed elsewhere in this config.
      expose_files: true
      # lazy hides this server's real tool schemas from every turn's default
      # list, replacing them with one line inside the shared
      # load_tool_group stub tool — the model calls it to unlock this
      # server's real tools only for turns that actually need them (see
      # docs/adr/lazy-mcp-tool-loading.md). description is then required —
      # it's what the model reads to decide whether to load this domain.
      lazy: true
      description: "Code execution sandbox (bash/python): calculations, file processing, PDF generation."
    # Example: a diary MCP server (github.com/archer-developer/miranda-diary)
    # that supports per-user encryption — encryption_key_allowed lets
    # executeTool inject the calling user's unwrapped master key (see
    # internal/keyring, docs/encryption.md — the keyring itself is always
    # on) as a tool-call argument on every call to *this*
    # server specifically, and only this server; it's rejected at startup
    # (config.validateEncryptionKeyServers) unless url is "https://", since
    # sending real key material over plaintext HTTP would defeat the whole
    # point. Uncomment and point at a real, TLS-terminated diary instance
    # to use it.
    # - name: diary
    #   url: "https://diary.example.com/mcp"
    #   token_env: "DIARY_MCP_TOKEN"
    #   enabled: true
    #   encryption_key_allowed: true
    #   lazy: true
    #   description: "Personal diary: notes, thoughts, events — semantic search."
    # Example: a medical-records MCP server
    # (github.com/archer-developer/miranda-medical-card) whose medical.ask
    # tool supports an optional sessionId parameter so follow-up questions
    # can reuse context from earlier in the same conversation —
    # session_id_tools lets executeTool inject Miranda's own resolved
    # conversation id into calls to *those specific tools only* (unlike
    # encryption_key_allowed above, this is per-tool, not server-wide, since
    # most tools on a server won't declare a session-id parameter at all —
    # see docs/medical-card-session-injection.md). session_id_arg overrides
    # the argument name the tool's schema expects it under; left unset, the
    # default "sessionId" is used. expose_files here is the same
    # file-download opt-in as code_exec_sandbox above — medical.get_document
    # returns a fileUri Miranda proxies back to the browser.
    # - name: medical_card
    #   url: "https://medical-card.example.com/mcp"
    #   token_env: "MEDICAL_CARD_MCP_TOKEN"
    #   enabled: true
    #   expose_files: true
    #   session_id_tools: ["medical.ask"]
    #   lazy: true
    #   description: "Medical records: Q&A over the full medical history; health profile (diagnoses, medications, allergies, vaccinations, labs, vitals); event timeline; documents; self-reported events; upcoming-action reminders; diagnosis resolution."
    # Google Calendar is NOT an MCP server entry here — Google's own hosted
    # Calendar MCP server (calendarmcp.googleapis.com) turned out to be
    # gated behind enrollment in the Google Workspace Developer Preview
    # Program, so Miranda instead ships its own native calendar_* tools
    # (internal/calendar, internal/httpapi/calendar_tools.go) against the
    # plain, generally-available Calendar API v3 REST endpoints, using the
    # same oauth.providers google_calendar entry above for per-user tokens.
    # Nothing to configure here beyond oauth.enabled: true — see that
    # section's own comments.

# Optional file upload support for the web UI — lets users attach files before
# sending a message. Miranda stages an uploaded file's bytes locally
# (internal/attachments.Store) and hands the model a fileURI under
# public_base_url (e.g. "http://192.168.1.50:8787/files/<id>") rather than
# pushing the bytes anywhere itself — whichever tool the model calls with
# that URI is responsible for fetching it over a plain HTTP GET (see
# docs/file-staging-refactor.md). public_base_url must be reachable by every
# service whose tools might need to fetch an uploaded file this way (the
# sandbox, miranda-medical-card, ...), not just by the browser.
#
# The other direction — GET /api/files/{file_id} proxying a file some other
# backend service's tool produced (the sandbox's download_file, or any other
# server's tool that hands back a file_uri/fileUri) back out to the browser
# — has no config of its own here: it's controlled per-server by that
# server's own expose_files: true in mcp.servers above (see
# code_exec_sandbox's entry), not by anything under file_upload.
file_upload:
  enabled: true
  public_base_url: "http://192.168.1.50:8787"
  max_file_size_bytes: 52428800 # 50 MB — same as the sandbox's staged_files default
  # How long a download record (see mcp.servers' expose_files above) stays
  # valid before GET /api/files/{file_id} starts 404ing it — longer than an
  # upload-staging record's own short TTL, since a download link is embedded
  # durably in conversation history and can be revisited long after the turn
  # that created it. 720 hours = 30 days.
  download_record_ttl_hours: 720

tts:
  # yandex_station_text (Yandex Station's own built-in voice — the default,
  # zero external dependencies) or gemini_tts (renders audio via Gemini's
  # API and plays it back through the same station as a fetched file — see
  # gemini_tts: below). Dispatch is asynchronous either way: replies are
  # enqueued onto a background player and never block the turn on synthesis
  # or physical playback (see README).
  primary: yandex_station_text
  # Friendly name (not entity_id) of the media_player that receives TTS
  # output when speak_reply's optional device argument isn't given — resolved
  # to an entity_id via the HA REST API at runtime. Leave empty if you only
  # ever have one entity in yandex_station.entities below.
  default_device: ""
  yandex_station:
    entities: [] # media_player.* entity ids of your Yandex Stations
    chunk_max_chars: 100 # Yandex Station's real-world text limit, even locally
    idle_poll_interval_ms: 300
    # Max time to wait, after play_media, for the entity to actually leave
    # "idle" before giving up on that wait and moving on. Needed because the
    # entity briefly still reports the *previous* idle state right after
    # play_media returns (synthesis + station wake-up latency) — without
    # this two-phase wait, the dispatcher could mistake that stale "idle"
    # for "already finished" and fire the next chunk mid-utterance.
    playback_start_timeout_ms: 3000
  # Retried, with the same text, if primary's Speak reports its quota
  # exhausted (gemini_tts exhausting every configured API key, most
  # notably) — so the user still hears *something* instead of silence.
  # Equal to primary (the default) disables the fallback path.
  fallback: yandex_station_text
  gemini_tts:
    # Opt-in: needs real API keys and its own quota/cost tradeoffs, unlike
    # the always-available yandex_station_text.
    enabled: false
    # Environment variable names, each holding one Gemini API key (never the
    # keys themselves — see .env.example). Listing several lets Miranda
    # rotate across them when one hits its quota (see README).
    api_key_envs: ["GEMINI_API_KEY_1", "GEMINI_API_KEY_2"]
    model: "gemini-3.1-flash-tts-preview"
    voice: "Kore" # one of Gemini's prebuilt voice names
    # "wav" (a bare RIFF header, no dependency) or "mp3" (via shine-mp3, pure
    # Go). Whether a real Yandex Station accepts WAV over play_media's URL
    # playback isn't verified against real hardware yet — try "mp3" if WAV
    # doesn't play.
    audio_format: "wav"
    # Where the Yandex Station can reach Miranda's own GET /tts-audio/ route
    # — e.g. Miranda's LAN address, or a reverse-proxied hostname.
    public_base_url: "http://192.168.1.50:8787"
    chunk_max_chars: 200
    request_timeout_seconds: 30
    quota_cooldown_seconds: 5
    max_quota_retry_cycles: 3
  # Lets the model call speak_reply to dispatch this turn's reply to
  # tts.primary even when the request didn't arrive via ha_assist, when the
  # user explicitly asks to hear the answer read aloud.
  speak_reply_tool: true
  # Lets the model call stop_speech to interrupt whatever is currently
  # speaking/queued, e.g. when the user explicitly asks Miranda to stop
  # talking mid-reply.
  stop_speech_tool: true

web_ui:
  enabled: true
  # Recent hub.Event entries replayed to a newly connected browser tab.
  # Shared by chat/tool events and the Logs screen's mirrored app/LLM-trace
  # log lines, so it needs more headroom than a chat-only buffer.
  log_buffer_size: 2000
  default_language: "ru" # ru | be | en — used for the login page and any user without their own `language`

webauthn:
  # Optional passwordless/biometric ("passkey") login — off by default,
  # since there's no safe auto-detected rp_id/rp_origins for a given
  # deployment. WebAuthn is a browser API that only works in a secure
  # context (HTTPS, or http://localhost) — plain http://<lan-ip> will not
  # work, even with this enabled; front Miranda with a reverse proxy that
  # terminates TLS and point rp_id/rp_origins at *that* hostname, not at
  # server.http_addr.
  enabled: false
  rp_id: "" # bare hostname, no scheme/port, e.g. "miranda.example.com" — changing this later orphans every registered passkey
  rp_display_name: "Miranda"
  rp_origins: [] # full origins the browser may reach Miranda through, e.g. ["https://miranda.example.com"]

telegram:
  # Optional Telegram bot channel — off by default, same reasoning as
  # webauthn above: there's no safe auto-detected public_base_url. Needs
  # HTTPS too; front Miranda with a reverse proxy and point public_base_url
  # at *that* hostname. Also needs TELEGRAM_BOT_TOKEN (from @BotFather) set
  # in the environment — see .env / README — and each household member who
  # should be recognized needs their `telegram_name` set below. The
  # webhook's auth secret is generated fresh at every startup and
  # re-registered with Telegram automatically; there's nothing to configure
  # for that part.
  enabled: true
  webhook_path: "/telegram/webhook"
  public_base_url: "https://miranda.phoenixfw.net" # e.g. "https://miranda.example.com"
  # Lets the model call send_telegram to proactively message a household
  # member's Telegram (e.g. "отправь мне на телефон ...", "отправь Ане на
  # телефон ..."). Only works for someone who has messaged the bot at least
  # once — Telegram gives bots no way to message a user who hasn't.
  send_message_tool: true
  # Leave true for the one process that should own this bot's webhook
  # (the normal case). Set to false for a second, non-production instance
  # pointed at this same config directory via MIRANDA_CONFIG_DIR (e.g.
  # local debugging unrelated to Telegram) — otherwise its startup steals
  # the webhook registration from whichever instance is actually deployed,
  # and that one stops receiving messages until it restarts. See
  # TelegramConfig.RegisterWebhook in internal/config/config.go.
  register_webhook: true

# Masks sensitive values out of text before it is written to disk — the
# SQLite dialog log (including its FTS index), the markdown memory files,
# scheduled-task prompts, and logs/llm.log + logs/anomalies/. Detection is
# deterministic: a trigger lexicon plus a short proximity window, and a set of
# self-identifying formats. See internal/redact for the engine.
#
#   "пин-код от телефона Ани 665533"  ->  "пин-код от телефона Ани ******"
#
# The boundary is the *disk*, not the network. The in-flight request still
# carries the user's original words to the model, so the assistant can act on
# a secret it was just told — but the next turn replays the conversation from
# SQLite, so it reads the masked text and no longer knows the value. Masking
# is irreversible: there is no vault and no un-masking path.
#
# On by default, unlike the other gated features above: this one needs no key
# or URL, and writing pin codes verbatim into a permanent log is the worse
# failure mode of the two.
redact:
  enabled: true
  # Asterisks one masked value becomes, at most. The whole matched span is
  # always replaced; this only bounds how many stars stand in for it, so a
  # redacted private key doesn't become a wall of them.
  max_mask_length: 32
  # How far past a trigger word a value may *start* and still count as that
  # trigger's value, in runes. 40 is sized off the example above, which puts
  # 18 characters of ordinary Russian between "пин-код" and the number. This
  # does not bound how *long* a value may be — a long API key right after
  # "пароль:" is still masked whole.
  window_runes: 40
  # Regexp fragments, not literals, matched case-insensitively (Cyrillic
  # included). The trailing [\p{L}]* on the Russian stems stands in for a
  # stemmer: one entry covers пин-код / пин-кода / пин-кодом.
  #
  # NOTE: as with `users` and `mcp.servers`, YAML replaces a list wholesale
  # rather than merging it — uncommenting this drops the built-in lexicon
  # entirely, so copy the whole list if you override it. To merely *add* a
  # rule, use extra_patterns below instead. The list here is the shipped
  # default, verbatim from internal/config.Default().
  # A trigger is also rejected when a letter *follows* it, which is what
  # makes a bare stem like 'пин' safe to list: it cannot fire inside
  # "пингвин". A following digit is still allowed, so "пин1234" is caught.
  # triggers:
  #   - 'пин[-\s]?код[\p{L}]*'
  #   - 'пин'
  #   - 'pin[-\s]?code'
  #   - '\bpin\b'
  #   - 'парол[\p{L}]*'
  #   - 'password'
  #   - 'passphrase'
  #   - 'код[\p{L}]*'
  #   - '\bcode\b'
  #   - 'секрет[\p{L}]*'
  #   - '\bsecret\b'
  #   - 'ключ[\p{L}]*'
  #   - '\bapi[-_\s]?key\b'
  #   - 'токен[\p{L}]*'
  #   - '\btoken\b'
  #   - 'cvv'
  #   - 'cvc'
  #   - 'сид[-\s]?фраз[\p{L}]*'
  #   - 'seed[-\s]?phrase'
  #   - 'мнемоник[\p{L}]*'
  #   - 'mnemonic'
  #   - 'паспорт[\p{L}]*'
  #   - 'снилс'
  #   - '\bинн\b'
  #
  # Suppress a trigger that matched inside a longer phrase. A trigger
  # preceded by a letter or digit is already rejected as a mid-word match, so
  # "код" inside "промокод" needs no entry here — this list is for the cases
  # that check cannot see: hyphenated compounds, where the preceding
  # character is punctuation, and multi-word phrases.
  # trigger_exclusions:
  #   - 'штрих[-\s]?код[\p{L}]*'
  #   - 'qr[-\s]?код[\p{L}]*'
  #   - 'qr[-\s]?code'
  #   - 'почтов[\p{L}]*\s+код[\p{L}]*'
  #   - 'код[\p{L}]*\s+ошибки'
  #   - 'код[\p{L}]*\s+город[\p{L}]*'
  #   - 'код[\p{L}]*\s+стран[\p{L}]*'
  #   - 'код[\p{L}]*\s+региона'
  #   - 'error\s+code'
  #   - 'zip\s?code'
  #   - 'area\s+code'
  #
  # Self-identifying values, masked with no trigger word needed. The rules
  # themselves are code (several need a check a regexp can't express — the
  # card rule verifies a Luhn checksum), so this only switches them on. An
  # unknown name here fails startup rather than silently doing nothing.
  #   card            13-19 digits with a valid Luhn checksum
  #   jwt             eyJ........
  #   api_key         sk-/sk-ant-/ghp_/AIza/xox?- prefixed keys
  #   telegram_token  <bot id>:<35-char secret>
  #   bearer          the credential after "Bearer ", keeping the label
  #   private_key     the body between PEM markers, keeping the markers
  #   snils           ###-###-### ##
  #   iban
  formats: [card, jwt, api_key, telegram_token, bearer, private_key, snils, iban]
  # Deployment-specific patterns, *appended* to the built-in rules rather
  # than replacing them. With a capture group, only group 1 is masked, so a
  # pattern can match context and redact just part of it. Compiled at
  # startup, so a broken regexp fails the boot.
  extra_patterns: []
  # - 'ACME-(\d{6})'

# Web UI login is mandatory — with no users listed here, the dashboard is
# unreachable (fails closed by design, not a bug). Generate a password hash
# with `go run ./cmd/hashpw <password>`; plaintext passwords are never
# stored anywhere.
#
# Username doubles as the canonical identity for history/memory
# (data/memory/<username>.md). ha_user_id, if set, maps a Home Assistant
# speaker-recognition user id to this same username, so a person's memory is
# shared whether they talk to Miranda via HA voice or via a logged-in web UI
# session — find it under that HA user's profile, or log the raw value
# Miranda receives from HA and copy it here. telegram_name (only relevant
# when telegram.enabled) does the same job for the Telegram channel: it's
# this person's Telegram @username, with or without the leading "@". The
# example hashes below are both for the password "555" — change them before
# exposing this to anything but your own LAN.
users:
  - username: alex
    password_hash: "$2a$10$6MwP/mihjsXkugdv4NtBOezKCw0fHnOgepn9LJOPQyWkEr0WA8w2e" # "555"
    full_name: "Alex"
    avatar: "" # https URL, or a path served under /static/avatars/
    ha_user_id: ""
    telegram_name: ""
    language: "ru"
    timezone: "Europe/Minsk" # IANA timezone for scheduled tasks; defaults to server's local timezone
  - username: anna
    password_hash: "$2a$10$cR6srtGvKY2swOq0Nd.lvuuplR.Retvj3PBX6PyLiFIzMBVE10FLi" # "555"
    full_name: "Anna"
    avatar: ""
    ha_user_id: ""
    telegram_name: ""
    language: "ru"
    timezone: "Europe/Minsk"
