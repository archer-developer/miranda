# Copy to .env and fill in — see README "Configuration". Loaded at startup
# by internal/envfile; any variable already set in the real environment
# always takes priority over what's in this file.

# Bearer token required on POST /api/v1/input and GET /ws/logs — the name
# comes from server.auth_token_env in config.yaml, which defaults to this.
# Generate one with `openssl rand -hex 32`.
#
# Leaving it empty does NOT mean "no token required": it disables the bearer
# check entirely, so anything that can reach the port can issue commands and
# read every conversation. Miranda warns about this at startup. Only safe if
# the listeners are genuinely unreachable from outside — note that TLS on a
# public hostname (e.g. for a Telegram webhook) exposes the same routes.
#
# The same value must be entered in the Home Assistant integration
# (Settings -> Devices & Services -> Miranda -> Configure).
MIRANDA_AUTH_TOKEN=

# Whichever env var name each llm.providers[].api_key_env entry in
# config.yaml points at, e.g.:
ANTHROPIC_API_KEY=

# Whichever env var name each mcp.servers[].token_env entry in config.yaml
# points at, e.g. for the Home Assistant MCP server:
HA_MCP_TOKEN=

# Only needed if tts.ha_tts.enabled or Yandex Station TTS talks to HA's REST
# API directly, rather than only through the MCP tool calls above.
HA_BASE_URL=
HA_TOKEN=

# Can be created at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Only needed if tts.gemini_tts.enabled is true. Whichever env var names
# tts.gemini_tts.api_key_envs in config.yaml point at — one Gemini API key
# each. Listing more than one lets Miranda rotate across them when one hits
# its quota (see README's TTS section).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Only needed if tavily.web_search.enabled or tavily.web_fetch.enabled is
# true (see README's Configuration section) — an API key from
# https://app.tavily.com/home.
TAVILY_API_KEY=

# MCP server token for the code execution sandbox
SANDBOX_MCP_TOKEN=

# MCP server token for the diary service
DIARY_MCP_TOKEN=

# MCP server token for the Yazio service
YAZIO_MCP_TOKEN=

# Only needed if oauth.enabled is true (internal/oauth2, docs/adr/oauth2-layer.md).
# Key refresh/access tokens are encrypted at rest under — generate with
# `openssl rand -base64 32`.
OAUTH_MASTER_KEY=

# Only needed for the oauth.providers google_calendar entry — OAuth 2.0
# Client ID/Secret from Google Cloud Console (see README/config.yaml.dist
# comments for the setup steps).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=