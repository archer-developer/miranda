{
  "name": "Miranda",
  "short_name": "Miranda",
  "description": "Miranda voice assistant dashboard",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#160b2e",
  "theme_color": "#160b2e",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/static/v{{.AssetVersion}}/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/v{{.AssetVersion}}/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/v{{.AssetVersion}}/brand/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/v{{.AssetVersion}}/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
